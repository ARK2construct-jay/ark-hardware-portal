# MongoDB Atlas connection string (existing hardware-selection cluster).
MONGODB_URI=mongodb+srv://<user>:<password>@hardware-selection.dcnpff4.mongodb.net/?authSource=admin

# Long random secret used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Gmail address used to send OTP password-reset codes.
GMAIL_USER=arksimplif@gmail.com
# App Password (NOT your normal Gmail password) — generate one at
# https://myaccount.google.com/apppasswords after enabling 2-Step Verification.
GMAIL_APP_PASSWORD=
